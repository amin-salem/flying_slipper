# Copy this file to .env and fill it in.

# "dev" or "prod". In prod the server refuses to start with the default secrets.
ENV=dev

# Database. Local testing: SQLite file. Production: PostgreSQL.
DATABASE_URL=sqlite+aiosqlite:///./flying_slipper.db
# DATABASE_URL=postgresql+asyncpg://slipper:CHANGE_ME@db:5432/slipper

# Long random strings (e.g. run:  python -c "import secrets; print(secrets.token_urlsafe(48))")
JWT_SECRET=change-me-dev-only
ADMIN_API_KEY=change-me-admin-dev-only

# Create tables automatically on start (fine for dev; in prod use: alembic upgrade head)
AUTO_CREATE_TABLES=true

# ---- Cafe Bazaar purchase checking ----
# fake       : accepts purchase tokens that start with "test-" (for development)
# api_secret : uses the API secret from the Bazaar developer panel (header)
# oauth      : uses client_id / client_secret / refresh_token (older method)
BAZAAR_MODE=fake
# Your app package name (applicationId in android/app/build.gradle.kts)
BAZAAR_PACKAGE_NAME=com.example.flying_slipper
BAZAAR_API_SECRET=
BAZAAR_CLIENT_ID=
BAZAAR_CLIENT_SECRET=
BAZAAR_REFRESH_TOKEN=

# Database password used by docker-compose (production)
POSTGRES_PASSWORD=change-me

# ---- Docker only ----
# Python package mirror used while building the image (PyPI is slow in Iran).
# Liara's free mirror; set it to https://pypi.org/simple outside Iran.
PIP_INDEX_URL=https://package-mirror.liara.ir/repository/pypi/simple/
# Docker images (python, postgres, caddy) through Liara's Docker Hub mirror.
# Leave empty to use Docker Hub directly.
IMAGE_PREFIX=docker-mirror.liara.ir/library/
# If you have a VPN with an HTTP proxy on this computer, the build can use it:
# BUILD_PROXY=http://127.0.0.1:10809
# 127.0.0.1 = API reachable only from this computer; 0.0.0.0 = also from your phone on Wi-Fi
API_BIND=127.0.0.1

# ---- SMS login codes (phone number accounts) ----
# fake      : no SMS; in ENV=dev the code is shown in the app (for testing)
# kavenegar : Kavenegar "verify lookup"  -> KAVENEGAR_API_KEY + KAVENEGAR_TEMPLATE
# smsir     : SMS.ir "verify"            -> SMS_IR_API_KEY + SMS_IR_TEMPLATE_ID (+ SMS_IR_PARAM)
SMS_PROVIDER=fake
KAVENEGAR_API_KEY=
KAVENEGAR_TEMPLATE=
SMS_IR_API_KEY=
SMS_IR_TEMPLATE_ID=0
SMS_IR_PARAM=CODE
